   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "1. Searching for a 'Hub Insider' using lazy streaming...\n",
      "Found Hub Insider: 70858\n",
      "Extracting global subgraph for associated Companies: [1159038, 1258623, 1074690]\n"
     ]
    },
    {
     "data": {
